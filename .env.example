# ------------------------------------------------------------
# Ovillo & Co. · Variables de entorno
#
# Copia este archivo a .env.local y rellena lo que necesites.
# Sin ninguna variable la tienda funciona igual con el catálogo de
# ejemplo de src/datos/semilla.ts. Nunca subas .env.local al repositorio.
# ------------------------------------------------------------

# URL pública del sitio, sin barra final. Se usa en metadatos, enlaces
# absolutos y en las URL de vuelta de Stripe.
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase  (Project Settings → API)
# Si defines estas dos, el catálogo se lee de Supabase; si no, de la
# semilla. Van siempre juntas.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (anon / publishable). Es pública por diseño: lo que
# protege los datos son las políticas RLS de supabase/migrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role / secret). Se salta RLS: solo en el
# servidor, nunca con el prefijo NEXT_PUBLIC_ y nunca en el navegador.
# La usa el webhook de Stripe para registrar los pedidos pagados.
SUPABASE_SERVICE_ROLE_KEY=

# Cuenta de rol «demo» para el botón público «Ver el panel de
# demostración». Solo la lee el servidor; nunca va al navegador. Sin ellas
# (y con Supabase), el botón avisa de que la demostración no está
# disponible. Sin Supabase el panel funciona en modo local y no hacen falta.
DEMO_PANEL_EMAIL=
DEMO_PANEL_PASSWORD=

# ------------------------------------------------------------
# Stripe, siempre en modo prueba  (Developers → API keys, con «Test mode»)
# La aplicación rechaza cualquier clave que no sea de prueba. Vacía (o
# incompleta), el pago funciona en modo demostración, sin pasarela.
# Tarjeta de prueba: 4242 4242 4242 4242, cualquier fecha futura y CVC.
# ------------------------------------------------------------
# Clave secreta de prueba (sk_test_…).
STRIPE_SECRET_KEY=
# Secreto de firma del webhook (whsec_…). En local lo muestra «stripe
# listen» al reenviar los eventos a la ruta del webhook de la tienda.
STRIPE_WEBHOOK_SECRET=

# Indexación en buscadores. Es una tienda de demostración: por defecto
# cada página lleva noindex para no competir con tiendas reales. Pon «si»
# solo si de verdad quieres que aparezca en los resultados.
NEXT_PUBLIC_INDEXAR=no
